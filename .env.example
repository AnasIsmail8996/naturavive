# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://naturavive.com

# Stripe - get keys from https://dashboard.stripe.com/apikeys
# Secret key must NEVER be prefixed with NEXT_PUBLIC_
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: Google Search Console verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: hero video CDN override
# NEXT_PUBLIC_HERO_VIDEO_URL=
